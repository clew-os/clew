{
  "realm": "clew",
  "displayName": "Clew",
  "enabled": true,
  "sslRequired": "external",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "qa",
        "description": "Quality assurance (internal)"
      },
      {
        "name": "procurement",
        "description": "Purchasing and goods receipt (internal)"
      },
      {
        "name": "chef",
        "description": "Kitchen lead (internal)"
      },
      {
        "name": "driver",
        "description": "Delivery driver (internal)"
      },
      {
        "name": "cskh",
        "description": "Customer care (internal)"
      },
      {
        "name": "director",
        "description": "Company director (internal)"
      },
      {
        "name": "approver",
        "description": "Second approver for four-eyes actions (internal)"
      },
      {
        "name": "customer_staff",
        "description": "Staff of a customer organization (portal only)"
      },
      {
        "name": "sensor",
        "description": "Machine identity for sensor readings"
      },
      {
        "name": "sysadmin",
        "description": "Platform administrator (tier 1): core admin page and the Keycloak admin console of this realm; no business data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "clew-api",
      "name": "clew API (audience)",
      "enabled": true,
      "publicClient": false,
      "secret": "${CLEW_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "clew-web",
      "name": "clew web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-clew-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "clew-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "clew-cli",
      "name": "clew CLI (device flow)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-clew-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "clew-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "sensor-gateway",
      "name": "Sensor gateway (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SENSOR_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-clew-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "clew-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "asset-codes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "asset_codes",
            "claim.value": "TU-MAT-01,TU-DONG-01,TU-MAU-01",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
